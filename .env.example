# JUSTO environment settings
# Copy this file to ".env" in the same folder, then edit the values.
# The app reads these with python-dotenv (and has a built-in backup reader).

# Africa's Talking sandbox credentials.
# Use AT_USERNAME=sandbox for the sandbox. Replace the API key with the real
# sandbox key from your Africa's Talking dashboard.
# If the key is still a placeholder, JUSTO prints every SMS to the console
# instead of failing - useful for the offline demo.
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here

# Port the Flask app listens on.
PORT=5000

# ---------------------------------------------------------------
# ngrok steps for the Africa's Talking sandbox USSD test
# ---------------------------------------------------------------
# 1. Start the app in one terminal:   python app.py
# 2. Start a public tunnel in another: ngrok http 5000
# 3. ngrok prints a public URL like:   https://abc123.ngrok-free.app
# 4. In the Africa's Talking dashboard go to USSD > Callback URL and set:
#      https://abc123.ngrok-free.app/ussd
#    (replace abc123 with your own ngrok subdomain)
# 5. Dial *384*2026# from the sandbox phone, or use the Phone (USSD) tab
#    inside the citizen app (http://localhost:5000/citizen).
# 6. For SMS receipts, set AT_USERNAME and AT_API_KEY above to the sandbox
#    values. Without them, SMS messages appear in the terminal console.
# ---------------------------------------------------------------
